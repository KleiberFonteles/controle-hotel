<!DOCTYPE html>
<html>
<head>
    <title>Usuários</title>
    <link rel="stylesheet" href="/style.css">

    <style>
        table{
            width:100%;
            border-collapse: collapse;
            background:white;
            color:black;
        }

        th, td{
            padding:12px;
            border:1px solid #ccc;
        }

        .container-lista{
            width:90%;
            margin:auto;
            margin-top:40px;
        }

        .btn-excluir{
            background:#dc2626;
            color:white;
            padding:8px 12px;
            border:none;
            border-radius:5px;
            text-decoration:none;
        }

        .btn-editar{
            background:#f59e0b;
            color:white;
            padding:8px 12px;
            border:none;
            border-radius:5px;
            text-decoration:none;
            margin-right: 5px;
        }
    </style>
</head>
<body>

<div class="container-lista">

<h1>Usuários - Listar</h1>

<a href="/cadastro.html">
<button>Incluir</button>
</a>
<a href="/crud.html">
<button style="background: #64748b; margin-left: 10px;">Voltar ao Painel</button>
</a>

<br><br>

<table>

<tr>
<th>ID</th>
<th>Nome</th>
<th>Email</th>
<th>Ações</th>
</tr>

<% usuarios.forEach(usuario => { %>

<tr>
<td><%= usuario.id %></td>
<td><%= usuario.nome %></td>
<td><%= usuario.email %></td>

<td>
<a class="btn-editar" href="/editar-usuario/<%= usuario.id %>">
Editar
</a>
<a class="btn-excluir" href="/excluir/<%= usuario.id %>" onclick="return confirm('Deseja realmente excluir este usuário?')">
Excluir
</a>
</td>

</tr>

<% }) %>

</table>

</div>

</body>
</html>