<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Usuário</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .container {
            width: 400px;
            margin: 50px auto;
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(0,0,0,0.3);
            text-align: center;
            color: #111;
        }
        h1 {
            color: #1e293b;
            margin-bottom: 20px;
            font-size: 28px;
        }
        form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        label {
            text-align: left;
            font-weight: bold;
            font-size: 14px;
            color: #475569;
            margin-left: 10px;
            display: block;
            margin-bottom: 5px;
        }
        input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
            box-sizing: border-box;
        }
        .btn-salvar {
            background: #2563eb;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            font-size: 16px;
            margin-top: 10px;
            transition: 0.3s;
            width: 100%;
        }
        .btn-salvar:hover {
            background: #1d4ed8;
        }
        .btn-cancelar {
            background: #64748b;
            color: white;
            padding: 10px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px;
            font-weight: bold;
            display: inline-block;
            margin-top: 10px;
            width: 100%;
            box-sizing: border-box;
        }
        .btn-cancelar:hover {
            background: #475569;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Editar Usuário</h1>
    
    <form action="/editar-usuario/<%= usuario.id %>" method="POST">
        <div>
            <label for="nome">Nome Completo</label>
            <input type="text" id="nome" name="nome" value="<%= usuario.nome %>" required autocomplete="off">
        </div>
        
        <div>
            <label for="email">E-mail</label>
            <input type="email" id="email" name="email" value="<%= usuario.email %>" required autocomplete="off">
        </div>
        
        <div>
            <label for="senha">Senha</label>
            <input type="text" id="senha" name="senha" value="<%= usuario.senha %>" required autocomplete="off">
        </div>
        
        <button type="submit" class="btn-salvar">Salvar Alterações</button>
    </form>
    
    <a class="btn-cancelar" href="/usuarios">Cancelar</a>
</div>

</body>
</html>
